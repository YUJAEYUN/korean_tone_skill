{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "date", "round_source", "cause", "causal_locus", "mechanism", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^fl-[0-9]{3,}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "round_source": {"type": "string", "minLength": 1},
    "case_ref": {"type": ["string", "null"]},
    "cause": {"type": "string", "minLength": 1},
    "causal_locus": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "reason_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["meaning", "voice", "naturalness", "fluency", "overediting", "instruction"]
      }
    },
    "status": {"type": "string", "minLength": 1}
  }
}
